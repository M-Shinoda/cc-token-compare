diff --git a/web/tests/user-menu-positioning.test.tsx b/web/tests/user-menu-positioning.test.tsx
new file mode 100644
index 0000000..7701638
--- /dev/null
+++ b/web/tests/user-menu-positioning.test.tsx
@@ -0,0 +1,50 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { describe, expect, it, vi } from "vitest";
+import UserMenu from "@/components/UserMenu";
+
+vi.mock("@/contexts/AppSidebarContext", () => ({ useAppSidebar: () => ({ setMobileOpen: vi.fn() }) }));
+vi.mock("@/contexts/AuthContext", () => ({
+  useAuth: () => ({ userGeneralSetting: undefined, refetchSettings: vi.fn(), logout: vi.fn() }),
+}));
+vi.mock("@/hooks/useCurrentUser", () => ({ default: () => undefined }));
+vi.mock("@/hooks/useLiveMemoRefresh", () => ({ useSSEConnectionStatus: () => "connected" }));
+vi.mock("@/hooks/useNavigateTo", () => ({ default: () => vi.fn() }));
+vi.mock("@/hooks/useUserQueries", () => ({
+  useNotifications: () => ({ data: [] }),
+  useUpdateUserGeneralSetting: () => ({ mutate: vi.fn() }),
+}));
+vi.mock("@/i18n", () => ({ locales: ["en", "ja"] }));
+vi.mock("@/utils/i18n", () => ({
+  getLocaleDisplayName: (locale: string) => locale,
+  getLocaleWithFallback: () => "en",
+  loadLocale: (locale: string) => locale,
+  useTranslate: () => (key: string) => key,
+}));
+vi.mock("@/utils/theme", () => ({
+  THEME_OPTIONS: [{ value: "system", label: "System" }],
+  getThemeWithFallback: () => "system",
+  loadTheme: vi.fn(),
+}));
+
+/** Base UI parks a positioner as `fixed` until it measures; wait for the measured state before asserting the strategy. */
+const expectFixedWhenSettled = async (menu: HTMLElement) => {
+  const positioner = menu.closest<HTMLElement>("[style*='position']") as HTMLElement;
+  await waitFor(() => {
+    expect(positioner.style.transform).not.toBe("");
+    expect(positioner).toHaveAttribute("data-side");
+  });
+  expect(positioner.style.position).toBe("fixed");
+};
+
+describe("UserMenu preference submenus", () => {
+  it.each(["setting.preference.theme", "common.language"])("positions the %s submenu with fixed positioning", async (name) => {
+    render(
+      <MemoryRouter>
+        <UserMenu onClose={vi.fn()} />
+      </MemoryRouter>,
+    );
+    fireEvent.click(screen.getByRole("button", { name: new RegExp(name) }));
+    await expectFixedWhenSettled(await screen.findByRole("menu"));
+  });
+});
