+func TestDeleteMemoDeletesNestedCommentsButNotReferences(t *testing.T) {
+	ctx := context.Background()
+	ts := NewTestingStore(ctx, t)
+	defer ts.Close()
+
+	author, err := ts.CreateUser(ctx, &store.User{Username: "delete-tree-author", Role: store.RoleUser, PasswordHash: "hash"})
+	require.NoError(t, err)
+	commenter, err := ts.CreateUser(ctx, &store.User{Username: "delete-tree-commenter", Role: store.RoleUser, PasswordHash: "hash"})
+	require.NoError(t, err)
+
+	parent, err := ts.CreateMemo(ctx, &store.Memo{UID: "tree-parent", CreatorID: author.ID, Content: "parent", Visibility: store.Public})
+	require.NoError(t, err)
+	other, err := ts.CreateMemo(ctx, &store.Memo{UID: "tree-other", CreatorID: author.ID, Content: "other", Visibility: store.Public})
+	require.NoError(t, err)
+	comment, err := ts.CreateMemoComment(ctx, &store.Memo{UID: "tree-comment", CreatorID: commenter.ID, Content: "c", Visibility: store.Public}, parent.ID, commenter.ID)
+	require.NoError(t, err)
+	reply, err := ts.CreateMemoComment(ctx, &store.Memo{UID: "tree-reply", CreatorID: author.ID, Content: "r", Visibility: store.Public}, comment.ID, author.ID)
+	require.NoError(t, err)
+	otherComment, err := ts.CreateMemoComment(ctx, &store.Memo{UID: "tree-other-comment", CreatorID: commenter.ID, Content: "oc", Visibility: store.Public}, other.ID, commenter.ID)
+	require.NoError(t, err)
+	_, err = ts.UpsertMemoRelation(ctx, &store.MemoRelation{MemoID: parent.ID, RelatedMemoID: other.ID, Type: store.MemoRelationReference})
+	require.NoError(t, err)
+
+	require.NoError(t, ts.DeleteMemo(ctx, &store.DeleteMemo{ID: parent.ID}))
+
+	for _, id := range []int32{parent.ID, comment.ID, reply.ID} {
+		got, err := ts.GetMemo(ctx, &store.FindMemo{ID: &id})
+		require.NoError(t, err)
+		require.Nil(t, got, "memo %d should be deleted", id)
+	}
+	for _, id := range []int32{other.ID, otherComment.ID} {
+		got, err := ts.GetMemo(ctx, &store.FindMemo{ID: &id})
+		require.NoError(t, err)
+		require.NotNil(t, got, "memo %d should survive", id)
+	}
 }
 
