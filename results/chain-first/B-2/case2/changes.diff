+
+// listMySQLMemoCommentTreeIDs returns the memo and all of its transitive
+// comments (replies to comments included), so deleting a memo never leaves
+// orphaned comments behind.
+func listMySQLMemoCommentTreeIDs(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	rows, err := tx.QueryContext(ctx, `WITH RECURSIVE memo_tree(id) AS (
+		SELECT ?
+		UNION
+		SELECT r.memo_id FROM memo_relation r JOIN memo_tree t ON r.related_memo_id = t.id WHERE r.type = 'COMMENT'
+	) SELECT id FROM memo_tree ORDER BY id`, memoID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	ids := make([]int32, 0, 1)
+	for rows.Next() {
+		var id int32
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	return ids, rows.Err()
+}
