diff --git a/web/tests/space-switcher.test.tsx b/web/tests/space-switcher.test.tsx
index 5ea5073..cff4cb6 100644
--- a/web/tests/space-switcher.test.tsx
+++ b/web/tests/space-switcher.test.tsx
@@ -229,4 +229,20 @@ describe("SpaceSwitcher", () => {
     expect(screen.queryByRole("combobox")).not.toBeInTheDocument();
     expect(screen.getByRole("button", { name: "Steven account" })).toBeInTheDocument();
   });
+
+  it.each(["md", "header"] as const)("keeps the %s popup and Space selector fixed to the viewport while the page scrolls", async (size) => {
+    renderAt("/", size);
+    openSwitcher();
+    const popup = document.querySelector('[data-slot="popover-content"]') as HTMLElement;
+    const popover = popup.parentElement as HTMLElement;
+    // Base UI starts in a temporary fixed state; wait until positioning has finished.
+    await waitFor(() => expect(popover.style.transform).not.toBe(""));
+    expect(popover).toHaveStyle({ position: "fixed" });
+
+    fireEvent.click(screen.getByRole("combobox", { name: "space.switch" }));
+    const listbox = await screen.findByRole("listbox");
+    const selectPositioner = listbox.closest('[data-slot="select-content"]')!.parentElement as HTMLElement;
+    await waitFor(() => expect(selectPositioner.style.transform).not.toBe(""));
+    expect(selectPositioner).toHaveStyle({ position: "fixed" });
+  });
 });
