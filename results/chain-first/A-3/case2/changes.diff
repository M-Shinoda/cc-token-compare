+
+// listMySQLMemoWithCommentDescendantIDs returns the memo and every comment
+// nested under it at any depth. UNION (not UNION ALL) guards against cycles.
+func listMySQLMemoWithCommentDescendantIDs(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	rows, err := tx.QueryContext(ctx, `WITH RECURSIVE descendants(id) AS (
+		SELECT ?
+		UNION
+		SELECT r.memo_id FROM memo_relation r JOIN descendants d ON r.related_memo_id = d.id WHERE r.type = 'COMMENT'
+	) SELECT id FROM descendants ORDER BY id`, memoID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	ids := make([]int32, 0, 1)
+	for rows.Next() {
+		var id int32
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	return ids, rows.Err()
+}
