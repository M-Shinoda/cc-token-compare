+
+func TestDeleteMemoDeletesNestedComments(t *testing.T) {
+	t.Parallel()
+	ctx := context.Background()
+	ts := NewTestingStore(ctx, t)
+	user, err := createTestingHostUser(ctx, ts)
+	require.NoError(t, err)
+	other, err := createTestingUserWithRole(ctx, ts, "commenter", store.RoleUser)
+	require.NoError(t, err)
+
+	newMemo := func(content string) *store.Memo {
+		memo, err := ts.CreateMemo(ctx, &store.Memo{UID: shortuuid.New(), CreatorID: user.ID, Content: content, Visibility: store.Public})
+		require.NoError(t, err)
+		return memo
+	}
+	newComment := func(content string, parent *store.Memo, author *store.User) *store.Memo {
+		comment, err := ts.CreateMemoComment(ctx, &store.Memo{UID: shortuuid.New(), CreatorID: author.ID, Content: content, Visibility: store.Public}, parent.ID, author.ID)
+		require.NoError(t, err)
+		return comment
+	}
+
+	parent := newMemo("parent")
+	comment := newComment("comment", parent, other)
+	reply := newComment("reply", comment, user)
+	sibling := newMemo("unrelated")
+	referenced := newMemo("referenced")
+	_, err = ts.UpsertMemoRelation(ctx, &store.MemoRelation{MemoID: parent.ID, RelatedMemoID: referenced.ID, Type: store.MemoRelationReference})
+	require.NoError(t, err)
+
+	_, err = ts.DeleteMemoWithPolicy(ctx, &store.DeleteMemoWithPolicy{MemoID: parent.ID, ActorUserID: user.ID})
+	require.NoError(t, err)
+
+	for _, deleted := range []*store.Memo{parent, comment, reply} {
+		got, err := ts.GetMemo(ctx, &store.FindMemo{ID: &deleted.ID})
+		require.NoError(t, err)
+		require.Nil(t, got, deleted.Content)
+	}
+	for _, kept := range []*store.Memo{sibling, referenced} {
+		got, err := ts.GetMemo(ctx, &store.FindMemo{ID: &kept.ID})
+		require.NoError(t, err)
+		require.NotNil(t, got, kept.Content)
+	}
+}
