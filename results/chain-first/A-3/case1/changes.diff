diff --git a/web/tests/positioner-fixed.ts b/web/tests/positioner-fixed.ts
new file mode 100644
index 0000000..b82bf1c
--- /dev/null
+++ b/web/tests/positioner-fixed.ts
@@ -0,0 +1,13 @@
+import { waitFor } from "@testing-library/react";
+import { expect } from "vitest";
+
+/**
+ * Base UI renders a positioner as `position: fixed` until its first position is computed, then switches to the
+ * configured method. Asserting immediately would pass for any popup, so wait for the computed `transform` first.
+ */
+export const expectFixedPositioner = async (popup: Element | null) => {
+  const positioner = popup?.parentElement;
+  expect(positioner).toBeTruthy();
+  await waitFor(() => expect((positioner as HTMLElement).style.transform).toContain("translate"));
+  expect(positioner).toHaveStyle({ position: "fixed" });
+};
