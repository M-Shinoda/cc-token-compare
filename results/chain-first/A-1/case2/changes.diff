+// listMySQLMemoWithComments returns the memo IDs in memoIDs together with every
+// COMMENT descendant (comments, replies to comments, and so on).
+func listMySQLMemoWithComments(ctx context.Context, tx *sql.Tx, memoIDs []int32) ([]int32, error) {
+	seen := make(map[int32]struct{}, len(memoIDs))
+	all := make([]int32, 0, len(memoIDs))
+	frontier := make([]int32, 0, len(memoIDs))
+	for _, id := range memoIDs {
+		if _, ok := seen[id]; !ok {
+			seen[id] = struct{}{}
+			all = append(all, id)
+			frontier = append(frontier, id)
+		}
+	}
+	for len(frontier) > 0 {
+		next := make([]int32, 0)
+		for _, batch := range deleteUserBatches(frontier, deleteUserBatchSize) {
+			clause, args := deleteUserInClause(1, batch)
+			args = append(args, store.MemoRelationComment)
+			rows, err := tx.QueryContext(ctx, "SELECT `memo_id` FROM `memo_relation` WHERE `related_memo_id` IN "+clause+" AND `type` = ?", args...)
+			if err != nil {
+				return nil, err
+			}
+			for rows.Next() {
+				var id int32
+				if err := rows.Scan(&id); err != nil {
+					_ = rows.Close()
+					return nil, err
+				}
+				if _, ok := seen[id]; !ok {
+					seen[id] = struct{}{}
+					all = append(all, id)
+					next = append(next, id)
+				}
+			}
+			if err := rows.Err(); err != nil {
+				_ = rows.Close()
+				return nil, err
+			}
+			_ = rows.Close()
+		}
+		frontier = next
+	}
+	return all, nil
+}
