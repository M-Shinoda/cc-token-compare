diff --git a/web/tests/fixed-positioning.helpers.ts b/web/tests/fixed-positioning.helpers.ts
new file mode 100644
index 0000000..56a19ea
--- /dev/null
+++ b/web/tests/fixed-positioning.helpers.ts
@@ -0,0 +1,14 @@
+import { waitFor } from "@testing-library/react";
+import { expect } from "vitest";
+
+/**
+ * Waits until Base UI has finished its first positioning pass, then asserts the positioner uses
+ * fixed positioning. Its initial pass renders with `transition: none`, so checking earlier could
+ * pass or fail on that temporary state instead of the configured strategy.
+ */
+export const expectSettledFixedPositioner = async (popup: HTMLElement | null) => {
+  const positioner = popup?.parentElement as HTMLElement | null | undefined;
+  expect(positioner).toBeTruthy();
+  await waitFor(() => expect(positioner!.style.transition).not.toBe("none"));
+  expect(positioner!.style.position).toBe("fixed");
+};
