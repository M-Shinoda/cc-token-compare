+
+// listMySQLCommentDescendantMemoIDs returns the memo and every comment nested
+// beneath it, so deleting a memo never leaves orphaned comments behind.
+func listMySQLCommentDescendantMemoIDs(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	rows, err := tx.QueryContext(ctx, "WITH RECURSIVE thread(id) AS (SELECT ? UNION SELECT r.memo_id FROM memo_relation r JOIN thread t ON r.related_memo_id = t.id WHERE r.type = 'COMMENT') SELECT id FROM thread ORDER BY id", memoID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	ids := []int32{}
+	for rows.Next() {
+		var id int32
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	return ids, rows.Err()
+}
