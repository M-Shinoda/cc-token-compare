+// listMySQLMemoCommentDescendants returns the IDs of every memo reachable from
+// rootID through COMMENT relations, so replies nested under comments are
+// included. The root itself is not part of the result.
+func listMySQLMemoCommentDescendants(ctx context.Context, tx *sql.Tx, rootID int32) ([]int32, error) {
+	seen := map[int32]struct{}{rootID: {}}
+	descendants := []int32{}
+	frontier := []int32{rootID}
+	for len(frontier) > 0 {
+		next := []int32{}
+		for _, batch := range deleteUserBatches(frontier, deleteUserBatchSize) {
+			clause, args := deleteUserInClause(1, batch)
+			rows, err := tx.QueryContext(ctx, "SELECT memo_id FROM memo_relation WHERE type = 'COMMENT' AND related_memo_id IN "+clause, args...)
+			if err != nil {
+				return nil, err
+			}
+			for rows.Next() {
+				var id int32
+				if err := rows.Scan(&id); err != nil {
+					_ = rows.Close()
+					return nil, err
+				}
+				if _, ok := seen[id]; ok {
+					continue
+				}
+				seen[id] = struct{}{}
+				descendants = append(descendants, id)
+				next = append(next, id)
+			}
+			if err := rows.Err(); err != nil {
+				_ = rows.Close()
+				return nil, err
+			}
+			if err := rows.Close(); err != nil {
+				return nil, err
+			}
+		}
+		frontier = next
+	}
+	return descendants, nil
+}
