@@ -0,0 +1,48 @@
+package mysql
+
+import (
+	"context"
+	"database/sql"
+
+	"github.com/pkg/errors"
+
+	"github.com/usememos/memos/store"
+)
+
+// listMySQLMemoWithComments returns the memo ID followed by every memo that is a
+// direct or nested comment of it, so deleting a memo does not orphan its replies.
+func listMySQLMemoWithComments(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	seen := map[int32]struct{}{memoID: {}}
+	ids := []int32{memoID}
+	frontier := []int32{memoID}
+	for len(frontier) > 0 {
+		var next []int32
+		for _, batch := range deleteUserBatches(frontier, deleteUserBatchSize) {
+			clause, args := deleteUserInClause(1, batch)
+			args = append(args, store.MemoRelationComment)
+			rows, err := tx.QueryContext(ctx, "SELECT memo_id FROM memo_relation WHERE related_memo_id IN "+clause+" AND type = "+deleteUserPlaceholder(len(batch)+1), args...)
+			if err != nil {
+				return nil, errors.Wrap(err, "failed to list memo comments")
+			}
+			for rows.Next() {
+				var id int32
+				if err := rows.Scan(&id); err != nil {
+					_ = rows.Close()
+					return nil, errors.Wrap(err, "failed to scan memo comment")
+				}
+				if _, ok := seen[id]; !ok {
+					seen[id] = struct{}{}
+					ids = append(ids, id)
+					next = append(next, id)
+				}
+			}
+			if err := rows.Err(); err != nil {
+				_ = rows.Close()
+				return nil, errors.Wrap(err, "failed to iterate memo comments")
+			}
+			_ = rows.Close()
+		}
+		frontier = next
+	}
+	return ids, nil
+}
