diff --git a/store/db/mysql/memo_delete_comments.go b/store/db/mysql/memo_delete_comments.go
new file mode 100644
index 0000000..18f8011
--- /dev/null
+++ b/store/db/mysql/memo_delete_comments.go
@@ -0,0 +1,49 @@
+package mysql
+
+import (
+	"context"
+	"database/sql"
+
+	"github.com/pkg/errors"
+
+	"github.com/usememos/memos/store"
+)
+
+// listMySQLCommentDescendantsTx returns the memo and every comment nested under it,
+// at any depth, so deleting a memo does not orphan its comment threads.
+func listMySQLCommentDescendantsTx(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	ids := []int32{memoID}
+	seen := map[int32]struct{}{memoID: {}}
+	frontier := []int32{memoID}
+	for len(frontier) > 0 {
+		var next []int32
+		for _, batch := range deleteUserBatches(frontier, deleteUserBatchSize) {
+			clause, args := deleteUserInClause(2, batch)
+			rows, err := tx.QueryContext(ctx, "SELECT memo_id FROM memo_relation WHERE `type` = ? AND related_memo_id IN "+clause,
+				append([]any{store.MemoRelationComment}, args...)...)
+			if err != nil {
+				return nil, errors.Wrap(err, "failed to list comment descendants")
+			}
+			for rows.Next() {
+				var id int32
+				if err := rows.Scan(&id); err != nil {
+					_ = rows.Close()
+					return nil, errors.Wrap(err, "failed to scan comment descendant")
+				}
+				if _, ok := seen[id]; ok {
+					continue
+				}
+				seen[id] = struct{}{}
+				ids = append(ids, id)
+				next = append(next, id)
+			}
+			err = rows.Err()
+			_ = rows.Close()
+			if err != nil {
+				return nil, errors.Wrap(err, "failed to iterate comment descendants")
+			}
+		}
+		frontier = next
+	}
+	return ids, nil
+}
