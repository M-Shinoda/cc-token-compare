+				if err := rows.Scan(&id); err != nil {
+					_ = rows.Close()
+					return nil, errors.Wrap(err, "failed to scan memo comment")
+				}
+				if _, ok := seen[id]; !ok {
+					seen[id] = struct{}{}
+					ids = append(ids, id)
+					next = append(next, id)
+				}
+			}
+			err = rows.Err()
+			_ = rows.Close()
+			if err != nil {
+				return nil, errors.Wrap(err, "failed to list memo comments")
+			}
+		}
+		frontier = next
+	}
+	return ids, nil
+}
