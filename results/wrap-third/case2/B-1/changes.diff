+func listMySQLMemoCommentDescendants(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	ids := []int32{memoID}
+	seen := map[int32]struct{}{memoID: {}}
+	frontier := []int32{memoID}
+	for len(frontier) > 0 {
+		var next []int32
+		for _, batch := range deleteUserBatches(frontier, deleteUserBatchSize) {
+			clause, args := deleteUserInClause(1, batch)
