diff --git a/web/tests/fixed-position-popups.test.tsx b/web/tests/fixed-position-popups.test.tsx
new file mode 100644
index 0000000..ee00ce7
--- /dev/null
+++ b/web/tests/fixed-position-popups.test.tsx
@@ -0,0 +1,63 @@
+import { render, screen, waitFor } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { DropdownMenu, DropdownMenuContent, DropdownMenuItem, DropdownMenuTrigger } from "@/components/ui/dropdown-menu";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
+import { Select, SelectContent, SelectItem, SelectTrigger } from "@/components/ui/select";
+
+// Base UI starts every positioner as `position: fixed` before measuring, so a bare assertion can pass
+// on that temporary state. Wait for positioning to finish (the side attribute is set) before asserting.
+const positionerOf = async (popup: HTMLElement) => {
+  const positioner = popup.parentElement as HTMLElement;
+  await waitFor(() => expect(positioner).toHaveAttribute("data-side"));
+  return positioner;
+};
+
+describe("popup positionMethod", () => {
+  it("popover uses fixed positioning when requested", async () => {
+    render(
+      <Popover open>
+        <PopoverTrigger>open</PopoverTrigger>
+        <PopoverContent positionMethod="fixed">content</PopoverContent>
+      </Popover>,
+    );
+    const positioner = await positionerOf(await screen.findByText("content"));
+    expect(positioner.style.position).toBe("fixed");
+  });
+
+  it("popover keeps absolute positioning by default", async () => {
+    render(
+      <Popover open>
+        <PopoverTrigger>open</PopoverTrigger>
+        <PopoverContent>content</PopoverContent>
+      </Popover>,
+    );
+    const positioner = await positionerOf(await screen.findByText("content"));
+    expect(positioner.style.position).toBe("absolute");
+  });
+
+  it("dropdown menu uses fixed positioning when requested", async () => {
+    render(
+      <DropdownMenu open>
+        <DropdownMenuTrigger>open</DropdownMenuTrigger>
+        <DropdownMenuContent positionMethod="fixed">
+          <DropdownMenuItem>item</DropdownMenuItem>
+        </DropdownMenuContent>
+      </DropdownMenu>,
+    );
+    const positioner = await positionerOf(await screen.findByRole("menu"));
+    expect(positioner.style.position).toBe("fixed");
+  });
+
+  it("select uses fixed positioning when requested", async () => {
+    render(
+      <Select open value="a">
+        <SelectTrigger>trigger</SelectTrigger>
+        <SelectContent positionMethod="fixed">
+          <SelectItem value="a">option</SelectItem>
+        </SelectContent>
+      </Select>,
+    );
+    const positioner = await positionerOf(await screen.findByRole("listbox"));
+    expect(positioner.style.position).toBe("fixed");
+  });
+});
