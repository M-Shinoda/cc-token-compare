diff --git a/web/tests/sidebar-popup-positioning.test.tsx b/web/tests/sidebar-popup-positioning.test.tsx
new file mode 100644
index 0000000..b351384
--- /dev/null
+++ b/web/tests/sidebar-popup-positioning.test.tsx
@@ -0,0 +1,98 @@
+import { QueryClient, QueryClientProvider } from "@tanstack/react-query";
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { describe, expect, it, vi } from "vitest";
+import SpaceSwitcher from "@/components/AppSidebar/SpaceSwitcher";
+
+const space = { name: "spaces/product", title: "Product", description: "" };
+
+vi.mock("@/components/MemosLogo", () => ({ default: () => <span>Memos logo</span> }));
+vi.mock("@/components/CreateSpaceDialog", () => ({ default: () => null }));
+vi.mock("@/contexts/AppSidebarContext", () => ({ useAppSidebar: () => ({ setMobileOpen: vi.fn() }) }));
+vi.mock("@/contexts/AuthContext", () => ({
+  useAuth: () => ({ logout: vi.fn(), userGeneralSetting: undefined, refetchSettings: vi.fn() }),
+}));
+vi.mock("@/contexts/SpaceContext", () => ({
+  useSpaceContext: () => ({
+    spaces: [space],
+    duplicateSpaceTitles: new Set<string>(),
+    selectedSpace: undefined,
+    selectedSpaceName: undefined,
+    creatorUsername: undefined,
+    isLoadingSpaces: false,
+    isSpacesError: false,
+    selectSpace: vi.fn(),
+  }),
+}));
+vi.mock("@/hooks/useCurrentUser", () => ({ default: () => ({ name: "users/test", username: "test", displayName: "Test" }) }));
+vi.mock("@/hooks/useLiveMemoRefresh", () => ({ useSSEConnectionStatus: () => "connected" }));
+vi.mock("@/hooks/useNavigateTo", () => ({ default: () => vi.fn() }));
+vi.mock("@/hooks/useUserQueries", () => ({
+  useUser: () => ({ data: undefined }),
+  useNotifications: () => ({ data: [] }),
+  useUpdateUserGeneralSetting: () => ({ mutate: vi.fn() }),
+}));
+vi.mock("@/i18n", () => ({ locales: ["en", "fr"], default: { language: "en" } }));
+vi.mock("@/utils/i18n", () => ({
+  useTranslate: () => (key: string) => key,
+  getLocaleDisplayName: (locale: string) => locale,
+  getLocaleWithFallback: () => "en",
+  loadLocale: (locale: string) => locale,
+}));
+vi.mock("@/utils/theme", () => ({
+  THEME_OPTIONS: [
+    { value: "system", label: "System" },
+    { value: "paper", label: "Paper" },
+  ],
+  getThemeWithFallback: () => "system",
+  loadTheme: vi.fn(),
+}));
+
+const renderSwitcher = (size: "md" | "header") =>
+  render(
+    <QueryClientProvider client={new QueryClient()}>
+      <MemoryRouter>
+        <SpaceSwitcher size={size} />
+      </MemoryRouter>
+    </QueryClientProvider>,
+  );
+
+// The positioner is the outermost element of the popup stack that carries a placement side.
+const positionerOf = (popup: HTMLElement) => {
+  let element = popup;
+  while (element.parentElement?.hasAttribute("data-side")) element = element.parentElement;
+  return element;
+};
+
+// Base UI renders a temporary `position: fixed` before the first measurement, so a fixed
+// positioner only proves the strategy once the computed transform has been applied.
+const expectFixedAfterPositioning = async (popup: HTMLElement) => {
+  await waitFor(() => {
+    const positioner = positionerOf(popup);
+    expect(positioner.style.transform).not.toBe("");
+    expect(positioner).toHaveAttribute("data-side");
+  });
+  expect(positionerOf(popup).style.position).toBe("fixed");
+};
+
+describe.each(["md", "header"] as const)("sidebar popup positioning (%s)", (size) => {
+  it("keeps the account popup, Space selector and preference submenus fixed", async () => {
+    renderSwitcher(size);
+    fireEvent.click(screen.getByRole("button", { name: "space.switch: common.memos" }));
+
+    await expectFixedAfterPositioning(
+      screen.getByText("common.sign-out").closest<HTMLElement>('[data-slot="popover-content"]') as HTMLElement,
+    );
+
+    fireEvent.click(screen.getByRole("combobox", { name: "space.switch" }));
+    await expectFixedAfterPositioning((await screen.findByRole("listbox")) as HTMLElement);
+    fireEvent.keyDown(screen.getByRole("listbox"), { key: "Escape" });
+
+    for (const name of ["setting.preference.theme", "common.language"]) {
+      fireEvent.click(screen.getByRole("button", { name: new RegExp(name) }));
+      await expectFixedAfterPositioning(await screen.findByRole("menu"));
+      fireEvent.keyDown(screen.getByRole("menu"), { key: "Escape" });
+      await waitFor(() => expect(screen.queryByRole("menu")).not.toBeInTheDocument());
+    }
+  });
+});
