diff --git a/web/tests/sidebar-popup-positioning.test.tsx b/web/tests/sidebar-popup-positioning.test.tsx
new file mode 100644
index 0000000..a86c05b
--- /dev/null
+++ b/web/tests/sidebar-popup-positioning.test.tsx
@@ -0,0 +1,86 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import SpaceSwitcher from "@/components/AppSidebar/SpaceSwitcher";
+
+const state = vi.hoisted(() => ({
+  currentUser: { name: "users/steven", username: "steven", displayName: "Steven", avatarUrl: "" },
+  spaces: [{ name: "spaces/product", title: "Product", description: "" }],
+}));
+
+vi.mock("@/components/MemosLogo", () => ({ default: () => <span>Memos</span> }));
+vi.mock("@/components/CreateSpaceDialog", () => ({ default: () => null }));
+vi.mock("@/contexts/AppSidebarContext", () => ({ useAppSidebar: () => ({ setMobileOpen: vi.fn() }) }));
+vi.mock("@/contexts/AuthContext", () => ({
+  useAuth: () => ({ userGeneralSetting: undefined, refetchSettings: vi.fn(), logout: vi.fn() }),
+}));
+vi.mock("@/contexts/SpaceContext", () => ({
+  useSpaceContext: () => ({
+    spaces: state.spaces,
+    duplicateSpaceTitles: new Set<string>(),
+    selectedSpace: undefined,
+    selectedSpaceName: undefined,
+    creatorUsername: undefined,
+    isLoadingSpaces: false,
+    isSpacesError: false,
+    selectSpace: vi.fn(),
+  }),
+}));
+vi.mock("@/hooks/useCurrentUser", () => ({ default: () => state.currentUser }));
+vi.mock("@/hooks/useLiveMemoRefresh", () => ({ useSSEConnectionStatus: () => "connected" }));
+vi.mock("@/hooks/useNavigateTo", () => ({ default: () => vi.fn() }));
+vi.mock("@/hooks/useUserQueries", () => ({
+  useUser: () => ({ data: undefined }),
+  useNotifications: () => ({ data: [] }),
+  useUpdateUserGeneralSetting: () => ({ mutate: vi.fn() }),
+}));
+vi.mock("@/utils/i18n", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/utils/i18n")>()),
+  useTranslate: () => (key: string) => key,
+}));
+
+/**
+ * Base UI renders every positioner as `position: fixed` until its first position is computed, so the
+ * assertion has to wait for the transform that marks the settled state; otherwise it passes without the fix.
+ */
+const expectFixedOnceSettled = async (popup: HTMLElement) => {
+  const positioner = popup.closest<HTMLElement>(".isolate") as HTMLElement;
+  await waitFor(() => expect(positioner.style.transform).not.toBe(""));
+  expect(positioner.style.position).toBe("fixed");
+};
+
+const renderSwitcher = (size: "md" | "header") =>
+  render(
+    <MemoryRouter>
+      <aside>
+        <SpaceSwitcher size={size} />
+      </aside>
+    </MemoryRouter>,
+  );
+
+describe("popups anchored in the fixed sidebar", () => {
+  beforeEach(() => {
+    localStorage.setItem("memos-locale", "en");
+    localStorage.setItem("memos-theme", "system");
+  });
+
+  it.each(["header", "md"] as const)("keeps the scope panel fixed in the %s variant", async (size) => {
+    renderSwitcher(size);
+    fireEvent.click(screen.getByRole("button", { name: /space.switch:/ }));
+    await expectFixedOnceSettled(await screen.findByRole("dialog"));
+  });
+
+  it("keeps the nested Space selector fixed", async () => {
+    renderSwitcher("header");
+    fireEvent.click(screen.getByRole("button", { name: /space.switch:/ }));
+    fireEvent.click(await screen.findByRole("combobox", { name: "space.switch" }));
+    await expectFixedOnceSettled(await screen.findByRole("listbox"));
+  });
+
+  it.each(["setting.preference.theme", "common.language"])("keeps the %s submenu fixed", async (label) => {
+    renderSwitcher("header");
+    fireEvent.click(screen.getByRole("button", { name: /space.switch:/ }));
+    fireEvent.click(await screen.findByRole("button", { name: new RegExp(label) }));
+    await expectFixedOnceSettled(await screen.findByRole("menu"));
+  });
+});
