diff --git a/web/tests/user-menu-positioning.test.tsx b/web/tests/user-menu-positioning.test.tsx
new file mode 100644
index 0000000..194ea79
--- /dev/null
+++ b/web/tests/user-menu-positioning.test.tsx
@@ -0,0 +1,34 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { describe, expect, it, vi } from "vitest";
+import UserMenu from "@/components/UserMenu";
+
+vi.mock("@/hooks/useCurrentUser", () => ({ default: () => undefined }));
+vi.mock("@/hooks/useLiveMemoRefresh", () => ({ useSSEConnectionStatus: () => "connected" }));
+vi.mock("@/hooks/useUserQueries", () => ({
+  useNotifications: () => ({ data: [] }),
+  useUpdateUserGeneralSetting: () => ({ mutate: vi.fn() }),
+}));
+vi.mock("@/contexts/AppSidebarContext", () => ({ useAppSidebar: () => ({ setMobileOpen: vi.fn() }) }));
+vi.mock("@/contexts/AuthContext", () => ({
+  useAuth: () => ({ userGeneralSetting: undefined, refetchSettings: vi.fn(), logout: vi.fn() }),
+}));
+vi.mock("@/utils/i18n", async (importOriginal) => ({
+  ...(await importOriginal<typeof import("@/utils/i18n")>()),
+  useTranslate: () => (key: string) => key,
+}));
+
+describe("UserMenu preference submenus", () => {
+  it.each(["setting.preference.theme", "common.language"])("anchors the %s submenu to the fixed sidebar", async (label) => {
+    render(
+      <MemoryRouter>
+        <UserMenu onClose={vi.fn()} />
+      </MemoryRouter>,
+    );
+    fireEvent.click(screen.getByRole("button", { name: new RegExp(label) }));
+    await waitFor(() => expect(document.querySelector('[data-slot="dropdown-menu-content"]')).toBeInTheDocument());
+    const positioner = document.querySelector('[data-slot="dropdown-menu-content"]')?.parentElement as HTMLElement;
+    await waitFor(() => expect(positioner.style.transform).not.toBe(""));
+    expect(positioner).toHaveStyle({ position: "fixed" });
+  });
+});
