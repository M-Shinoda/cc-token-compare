+func listMySQLMemoWithComments(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	rows, err := tx.QueryContext(ctx, `WITH RECURSIVE thread(id) AS (
+		SELECT ?
+		UNION
+		SELECT memo_relation.memo_id FROM memo_relation
+		JOIN thread ON memo_relation.related_memo_id = thread.id
+		WHERE memo_relation.type = 'COMMENT'
+	) SELECT id FROM thread`, memoID)
