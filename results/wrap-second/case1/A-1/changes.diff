diff --git a/web/tests/sidebar-popup-positioning.test.tsx b/web/tests/sidebar-popup-positioning.test.tsx
new file mode 100644
index 0000000..2550443
--- /dev/null
+++ b/web/tests/sidebar-popup-positioning.test.tsx
@@ -0,0 +1,83 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { describe, expect, it, vi } from "vitest";
+import SpaceSwitcher from "@/components/AppSidebar/SpaceSwitcher";
+
+vi.mock("@/components/CreateSpaceDialog", () => ({ default: () => null }));
+vi.mock("@/components/UserAvatar", () => ({ default: () => <span>avatar</span> }));
+vi.mock("@/components/SpaceMark", () => ({ default: () => <span>mark</span> }));
+vi.mock("@/components/SpaceSelectItem", () => ({ default: () => null }));
+vi.mock("@/components/MemosLogo", () => ({ default: () => <span>logo</span> }));
+vi.mock("@/hooks/useCurrentUser", () => ({ default: () => ({ name: "users/1", username: "alice", displayName: "Alice", avatarUrl: "" }) }));
+vi.mock("@/hooks/useUserQueries", () => ({
+  useUser: () => ({ data: undefined }),
+  useNotifications: () => ({ data: [] }),
+  useUpdateUserGeneralSetting: () => ({ mutate: vi.fn() }),
+}));
+vi.mock("@/hooks/useLiveMemoRefresh", () => ({ useSSEConnectionStatus: () => "connected" }));
+vi.mock("@/hooks/useNavigateTo", () => ({ default: () => vi.fn() }));
+vi.mock("@/contexts/AppSidebarContext", () => ({ useAppSidebar: () => ({ setMobileOpen: vi.fn() }) }));
+vi.mock("@/contexts/AuthContext", () => ({
+  useAuth: () => ({ userGeneralSetting: undefined, refetchSettings: vi.fn(), logout: vi.fn() }),
+}));
+vi.mock("@/contexts/SpaceContext", () => ({
+  useSpaceContext: () => ({
+    spaces: [],
+    duplicateSpaceTitles: new Set(),
+    selectedSpace: undefined,
+    selectedSpaceName: undefined,
+    creatorUsername: undefined,
+    isLoadingSpaces: false,
+    isSpacesError: false,
+    selectSpace: vi.fn(),
+  }),
+}));
+
+// Base UI first renders a temporary fixed state, so wait for positioning to finish.
+const positionerOf = async (element: HTMLElement) => {
+  const positioner = element.parentElement as HTMLElement;
+  await waitFor(() => expect(positioner.getAttribute("role")).toBe("presentation"));
+  // Let the first positioning pass settle; before it, Base UI reports position: fixed regardless of the prop.
+  await new Promise((resolve) => setTimeout(resolve, 100));
+  return positioner;
+};
+
+describe.each(["header", "md"] as const)("sidebar popups with the %s variant", (size) => {
+  it("keeps the scope popup, Space selector and preference submenus fixed", async () => {
+    render(
+      <MemoryRouter>
+        <SpaceSwitcher size={size} />
+      </MemoryRouter>,
+    );
+    fireEvent.click(screen.getAllByRole("button")[0]);
+
+    const content = await waitFor(() => {
+      const el = document.querySelector<HTMLElement>("[data-slot='popover-content']");
+      expect(el).not.toBeNull();
+      return el as HTMLElement;
+    });
+    expect((await positionerOf(content)).style.position).toBe("fixed");
+
+    fireEvent.click(screen.getByRole("combobox"));
+    const selectContent = await waitFor(() => {
+      const el = document.querySelector<HTMLElement>("[data-slot='select-content']");
+      expect(el).not.toBeNull();
+      return el as HTMLElement;
+    });
+    expect((await positionerOf(selectContent)).style.position).toBe("fixed");
+    fireEvent.keyDown(selectContent, { key: "Escape" });
+
+    for (const name of [/theme/i, /language/i]) {
+      const trigger = screen.getAllByRole("button").find((button) => name.test(button.textContent ?? ""));
+      expect(trigger).toBeDefined();
+      fireEvent.click(trigger as HTMLElement);
+      const menu = await waitFor(() => {
+        const el = document.querySelector<HTMLElement>("[data-slot='dropdown-menu-content']");
+        expect(el).not.toBeNull();
+        return el as HTMLElement;
+      });
+      expect((await positionerOf(menu)).style.position).toBe("fixed");
+      fireEvent.keyDown(menu, { key: "Escape" });
+    }
+  });
+});
