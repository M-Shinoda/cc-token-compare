diff --git a/web/tests/fixed-sidebar-popups.test.tsx b/web/tests/fixed-sidebar-popups.test.tsx
new file mode 100644
index 0000000..dcd667f
--- /dev/null
+++ b/web/tests/fixed-sidebar-popups.test.tsx
@@ -0,0 +1,120 @@
+import { fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { describe, expect, it, vi } from "vitest";
+import SpaceSwitcher from "@/components/AppSidebar/SpaceSwitcher";
+import { DropdownMenu, DropdownMenuContent, DropdownMenuTrigger } from "@/components/ui/dropdown-menu";
+import { Popover, PopoverContent, PopoverTrigger } from "@/components/ui/popover";
+import { Select, SelectContent, SelectItem, SelectTrigger } from "@/components/ui/select";
+
+vi.mock("@/components/CreateSpaceDialog", () => ({ default: () => null }));
+vi.mock("@/components/MemosLogo", () => ({ default: () => <span>Memos logo</span> }));
+
+vi.mock("@/contexts/AppSidebarContext", () => ({ useAppSidebar: () => ({ setMobileOpen: vi.fn() }) }));
+vi.mock("@/contexts/AuthContext", () => ({
+  useAuth: () => ({ userGeneralSetting: undefined, refetchSettings: vi.fn(), logout: vi.fn() }),
+}));
+vi.mock("@/contexts/SpaceContext", () => ({
+  useSpaceContext: () => ({
+    spaces: [{ name: "spaces/product", title: "Product", description: "" }],
+    duplicateSpaceTitles: new Set<string>(),
+    selectedSpace: undefined,
+    selectedSpaceName: undefined,
+    creatorUsername: undefined,
+    isLoadingSpaces: false,
+    isSpacesError: false,
+    selectSpace: vi.fn(),
+  }),
+}));
+vi.mock("@/hooks/useCurrentUser", () => ({ default: () => ({ name: "users/test", username: "test", displayName: "Test" }) }));
+vi.mock("@/hooks/useLiveMemoRefresh", () => ({ useSSEConnectionStatus: () => "connected" }));
+vi.mock("@/hooks/useUserQueries", () => ({
+  useNotifications: () => ({ data: [] }),
+  useUpdateUserGeneralSetting: () => ({ mutate: vi.fn() }),
+  useUser: () => ({ data: undefined }),
+}));
+vi.mock("@/i18n", () => ({ default: { language: "en" }, locales: ["en", "ja"] }));
+vi.mock("@/utils/i18n", () => ({
+  useTranslate: () => (key: string) => key,
+  getLocaleDisplayName: (locale: string) => locale,
+  getLocaleWithFallback: () => "en",
+  loadLocale: (locale: string) => locale,
+}));
+
+// Base UI parks a popup at `position: fixed` until its first position is computed, so a fixed
+// positioner only proves anything once the computed transform is in place.
+const settledPositioner = async (popup: HTMLElement) => {
+  const positioner = popup.parentElement as HTMLElement;
+  await waitFor(() => expect(positioner.style.transform).not.toBe(""));
+  return positioner;
+};
+
+describe("positionMethod on popup wrappers", () => {
+  it("keeps absolute positioning by default and honours fixed", async () => {
+    const { unmount } = render(
+      <>
+        <Popover>
+          <PopoverTrigger>pop-default</PopoverTrigger>
+          <PopoverContent data-testid="popover-default">x</PopoverContent>
+        </Popover>
+      </>,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "pop-default" }));
+    expect((await settledPositioner(await screen.findByTestId("popover-default"))).style.position).toBe("absolute");
+    unmount();
+
+    render(
+      <>
+        <Popover>
+          <PopoverTrigger>pop-fixed</PopoverTrigger>
+          <PopoverContent data-testid="popover-fixed" positionMethod="fixed">
+            x
+          </PopoverContent>
+        </Popover>
+        <DropdownMenu>
+          <DropdownMenuTrigger>menu-fixed</DropdownMenuTrigger>
+          <DropdownMenuContent positionMethod="fixed">x</DropdownMenuContent>
+        </DropdownMenu>
+        <Select value="a">
+          <SelectTrigger>select-fixed</SelectTrigger>
+          <SelectContent positionMethod="fixed" data-testid="select-fixed">
+            <SelectItem value="a">A</SelectItem>
+          </SelectContent>
+        </Select>
+      </>,
+    );
+    fireEvent.click(screen.getByRole("button", { name: "pop-fixed" }));
+    expect((await settledPositioner(await screen.findByTestId("popover-fixed"))).style.position).toBe("fixed");
+    fireEvent.click(screen.getByRole("button", { name: "menu-fixed" }));
+    expect((await settledPositioner(await screen.findByRole("menu"))).style.position).toBe("fixed");
+    fireEvent.click(screen.getByRole("combobox"));
+    expect((await settledPositioner(await screen.findByTestId("select-fixed"))).style.position).toBe("fixed");
+  });
+});
+
+describe.each(["header", "md"] as const)("sidebar scope popup (%s)", (size) => {
+  it("stays fixed for the panel, the Space selector and both preference submenus", async () => {
+    render(
+      <MemoryRouter>
+        <SpaceSwitcher size={size} />
+      </MemoryRouter>,
+    );
+
+    fireEvent.click(screen.getByRole("button", { name: /space\.switch/ }));
+    const panel = (await screen.findByText("setting.preference.theme")).closest("[data-slot='popover-content']") as HTMLElement;
+    expect((await settledPositioner(panel)).style.position).toBe("fixed");
+
+    fireEvent.click(screen.getByRole("combobox", { name: "space.switch" }));
+    const spaceList = (await screen.findByRole("option", { name: "Product" })).closest("[data-slot='select-content']") as HTMLElement;
+    expect((await settledPositioner(spaceList)).style.position).toBe("fixed");
+    fireEvent.keyDown(spaceList, { key: "Escape" });
+
+    for (const label of ["setting.preference.theme", "common.language"]) {
+      fireEvent.click(screen.getByRole("button", { name: new RegExp(label) }));
+      await waitFor(() => expect(document.querySelector("[data-slot='dropdown-menu-content']")).not.toBeNull());
+      const submenu = document.querySelector("[data-slot='dropdown-menu-content']") as HTMLElement;
+      expect((await settledPositioner(submenu)).style.position).toBe("fixed");
+      fireEvent.keyDown(submenu, { key: "Escape" });
+      await waitFor(() => expect(document.querySelector("[data-slot='dropdown-menu-content']")).toBeNull());
+    }
+  });
+});
