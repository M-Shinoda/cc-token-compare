+func expandMySQLMemoSetWithComments(ctx context.Context, tx *sql.Tx, memoIDs []int32) ([]int32, error) {
+	seen := make(map[int32]struct{}, len(memoIDs))
+	result := make([]int32, 0, len(memoIDs))
