+// mysqlMemoWithComments returns the memo and all of its transitive comments, so deleting a
+// memo never leaves orphaned comments that would surface as top-level memos.
+func mysqlMemoWithComments(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	ids := []int32{memoID}
+	seen := map[int32]struct{}{memoID: {}}
+	for i := 0; i < len(ids); i++ {
+		rows, err := tx.QueryContext(ctx, "SELECT memo_id FROM memo_relation WHERE related_memo_id = ? AND type = 'COMMENT'", ids[i])
+		if err != nil {
+			return nil, err
+		}
+		for rows.Next() {
+			var id int32
+			if err := rows.Scan(&id); err != nil {
+				_ = rows.Close()
+				return nil, err
+			}
+			if _, ok := seen[id]; !ok {
+				seen[id] = struct{}{}
+				ids = append(ids, id)
+			}
+		}
+		if err := rows.Err(); err != nil {
+			_ = rows.Close()
+			return nil, err
+		}
+		_ = rows.Close()
+	}
+	return ids, nil
+}
