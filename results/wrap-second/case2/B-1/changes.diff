+
+// listMySQLMemoCommentTree returns the memo and all of its nested comments.
+func listMySQLMemoCommentTree(ctx context.Context, tx *sql.Tx, memoID int32) ([]int32, error) {
+	rows, err := tx.QueryContext(ctx, `
+		WITH RECURSIVE tree(id) AS (
+			SELECT ?
+			UNION
+			SELECT r.memo_id FROM memo_relation AS r
+			JOIN tree ON r.related_memo_id = tree.id
+			WHERE r.type = 'COMMENT'
+		)
+		SELECT id FROM tree ORDER BY id`, memoID)
+	if err != nil {
+		return nil, err
+	}
+	defer rows.Close()
+	ids := make([]int32, 0)
+	for rows.Next() {
+		var id int32
+		if err := rows.Scan(&id); err != nil {
+			return nil, err
+		}
+		ids = append(ids, id)
+	}
+	return ids, rows.Err()
+}
